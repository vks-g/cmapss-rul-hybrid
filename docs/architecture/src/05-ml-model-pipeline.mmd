%% Phase 1 model architecture: one scikit-learn Pipeline per model and feature set,
%% tuned with GridSearchCV over the engine-grouped folds (COMPARISON_GRIDS).
flowchart LR
    X[("Training cycles<br/>raw frame with unit")]:::data

    subgraph SEARCH["GridSearchCV · 3 engine-grouped folds · scored by RMSE"]
        FEAT["EngineFeatures<br/>engineered → 155 predictors<br/>raw → 25 predictors"]:::fit
        RF["RandomForestRegressor<br/>max_features 0.5<br/>n_estimators 50 / 100<br/>min_samples_leaf 1 / 3"]:::model
        XGB["XGBRegressor (hist)<br/>n_estimators 100 / 200<br/>max_depth 3 / 5"]:::model
        EN["StandardScaler → ElasticNet<br/>alpha 0.1 / 1.0<br/>l1_ratio 0.2 / 0.8"]:::model
        FEAT --> RF
        FEAT --> XGB
        FEAT --> EN
    end

    BEST["Best candidate per model<br/>refit on all training engines"]
    OUT["6 fitted pipelines<br/>3 models × 2 feature sets"]:::output

    X --> FEAT
    RF --> BEST
    XGB --> BEST
    EN --> BEST
    BEST --> OUT

    classDef data fill:#e9f1fb,stroke:#2a78d6,color:#0b0b0b
    classDef fit fill:#fdeee7,stroke:#eb6834,color:#0b0b0b
    classDef model fill:#e6f6ef,stroke:#1baf7a,color:#0b0b0b
    classDef output fill:#fdf5e1,stroke:#eda100,color:#0b0b0b
