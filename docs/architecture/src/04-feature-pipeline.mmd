flowchart LR
    TRAIN[("Training engines<br/>raw readings")]:::data
    ANY[("Any split to transform<br/>train · validation · test<br/>unit · cycle · op_1–op_3 · s_1–s_21")]:::data

    subgraph FITSTEP["fit: training engines only"]
        SEL["select_sensors<br/>drop constant sensors<br/>FD001: 21 → 15"]:::fit
        KM["RegimeNormalizer.fit<br/>KMeans on op settings<br/>one scaler per regime"]:::fit
