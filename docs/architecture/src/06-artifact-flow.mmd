%% Phase 1 and Phase 2 artifact producers and consumers.
flowchart TB
    DL["scripts/download_data.py"]
    RAW[("data/raw/CMAPSSData/<br/>12 files; gitignored")]:::data
    P1["notebooks/phase1/01–04<br/>EDA → features → ML → results"]
    CFG["configs/*.yaml<br/>shared defaults + model settings"]:::data
    CV["scripts/train_dl.py<br/>scripts/run_ml_baselines.py<br/>training-engine CV; optional DL refit"]:::fit
    STUDY["notebooks/phase2/05–12<br/>cap → encoders → hybrids<br/>regularization · ablations · multi-regime"]
    FINAL["15_final_comparison.ipynb<br/>freeze fff9e06<br/>one official test run; reload when saved"]
    ANALYSIS["13_validation.ipynb<br/>14_interpretability.ipynb<br/>read saved predictions / checkpoints"]
    MET[("results/metrics/<br/>CV scores and predictions<br/>final_test.json + predictions.csv<br/>final_comparison.csv")]:::output
    FIG[("results/figures/<br/>learning curves · comparisons<br/>uncertainty · explanations")]:::output
    CKPT[("results/models/<br/>checkpoints; gitignored")]:::data
    DOCS["reports/phase1/ and phase2/<br/>presentations/"]:::output
    DL --> RAW
    RAW --> P1
    RAW --> CV
    CFG --> CV
    CV --> MET
    CV --> CKPT
    RAW --> STUDY --> MET
    STUDY --> FIG
    MET -- frozen settings --> FINAL
    RAW --> FINAL
    FINAL --> MET
    FINAL --> CKPT
    FINAL --> FIG
    MET --> ANALYSIS
    CKPT --> ANALYSIS --> FIG
    P1 --> MET
    P1 --> FIG
    MET --> DOCS
    FIG --> DOCS

